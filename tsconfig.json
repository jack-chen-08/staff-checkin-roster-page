{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "jest"
    ],
    "lib": [
      "ES2020",
      "DOM"
    ],
    "baseUrl": "."
  },
  "include": [
    "miniprogram/**/*.ts",
    "tests/**/*.ts",
    "types/**/*.d.ts"
  ]
}