.page {
  min-height: 100vh;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

/* ---------- 顶部进度卡 ---------- */
.hero {
  margin: 24rpx 24rpx 0;
  padding: 28rpx 28rpx 0;
  border-radius: 24rpx;
  background: linear-gradient(160deg, #ffffff 0%, #f7faff 100%);
  box-shadow: 0 6rpx 24rpx rgba(0, 82, 217, 0.08);
}

.hero__top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.hero__title {
  font-size: 34rpx;
  font-weight: 600;
  color: rgba(0, 0, 0, 0.9);
  line-height: 44rpx;
}

.hero__sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.4);
}

.live {
  display: flex;
  align-items: center;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 20rpx;
  background: #e3f9e9;
  color: #2ba471;
  font-size: 20rpx;
  white-space: nowrap;
}

.live__dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #2ba471;
}

.hero__body {
  display: flex;
  align-items: center;
  padding: 24rpx 0 20rpx;
}

.ring {
  position: relative;
  width: 278rpx;
  height: 278rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ring__center {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  text-align: center;
}

.ring__num {
  font-size: 56rpx;
  font-weight: 700;
  color: #0052d9;
  line-height: 62rpx;
  letter-spacing: -1rpx;
}

.ring__pct {
  font-size: 26rpx;
  font-weight: 600;
  margin-left: 2rpx;
}

.ring__cap {
  margin-top: 2rpx;
  font-size: 22rpx;
  color: rgba(0, 0, 0, 0.4);
}

.kpis {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding-left: 8rpx;
}

.kpi {
  text-align: center;
  min-width: 88rpx;
}

.kpi__num {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 48rpx;
  color: rgba(0, 0, 0, 0.9);
}

.kpi__num--ok {
  color: #2ba471;
}

.kpi__num--grey {
  color: rgba(0, 0, 0, 0.6);
}

.kpi__label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(0, 0, 0, 0.4);
}

.kpi__split {
  width: 1rpx;
  height: 44rpx;
  background: rgba(0, 0, 0, 0.06);
}

.hero__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  font-size: 22rpx;
  color: rgba(0, 0, 0, 0.35);
}

/* ---------- 筛选区 ---------- */
.filters {
  margin-top: 20rpx;
  background: #ffffff;
  padding-bottom: 20rpx;
}

.filters__search {
  padding: 12rpx 24rpx 0;
}

/* ---------- 错误条 ---------- */
.banner {
  display: flex;
  align-items: center;
  margin: 20rpx 24rpx 0;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  background: #fff1e9;
  font-size: 24rpx;
  color: #d54941;
}

.banner__text {
  flex: 1;
  margin-left: 10rpx;
  line-height: 34rpx;
}

.banner__retry {
  margin-left: 16rpx;
  color: #0052d9;
  font-weight: 500;
}

/* ---------- 名单 ---------- */
.list {
  margin: 20rpx 24rpx 0;
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
}

.row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.row:last-child {
  border-bottom: none;
}

.row__avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 500;
  color: rgba(0, 0, 0, 0.45);
  background: #f2f3f5;
}

.row__avatar--ok {
  background: #e3f0ff;
  color: #0052d9;
}

.row__main {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.row__head {
  display: flex;
  align-items: center;
}

.row__name {
  font-size: 30rpx;
  font-weight: 600;
  color: rgba(0, 0, 0, 0.9);
  max-width: 240rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.row__company {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.6);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.row__meta {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(0, 0, 0, 0.35);
}

.row__ticket {
  font-variant-numeric: tabular-nums;
}

.row__time {
  margin-left: 16rpx;
  color: rgba(0, 0, 0, 0.45);
}

.row__action {
  margin-left: 12rpx;
  flex-shrink: 0;
}

.tag {
  display: inline-flex;
  align-items: center;
  height: 34rpx;
  padding: 0 12rpx;
  margin-left: 12rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  line-height: 1;
  flex-shrink: 0;
}

.tag--ok {
  color: #2ba471;
  background: #e3f9e9;
}

.tag--grey {
  color: rgba(0, 0, 0, 0.4);
  background: #f2f3f5;
}

.list__foot {
  padding: 26rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: rgba(0, 0, 0, 0.3);
}

/* ---------- 加载 / 空 / 无权限 ---------- */
.loading-block {
  padding: 120rpx 0;
  display: flex;
  justify-content: center;
}

.empty-block {
  padding: 60rpx 0 80rpx;
}

.forbidden {
  padding: 160rpx 72rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.forbidden__icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #eeeeee;
  display: flex;
  align-items: center;
  justify-content: center;
}

.forbidden__title {
  margin-top: 32rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: rgba(0, 0, 0, 0.9);
}

.forbidden__desc {
  margin: 16rpx 0 48rpx;
  font-size: 26rpx;
  line-height: 40rpx;
  color: rgba(0, 0, 0, 0.5);
}
