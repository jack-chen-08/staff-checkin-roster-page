<t-dialog
  visible="{{visible}}"
  title="手动补签"
  confirm-btn="确认补签"
  cancel-btn="取消"
  confirm-button-loading="{{submitting}}"
  close-on-overlay-click="{{false}}"
  bind:confirm="onConfirm"
  bind:cancel="onCancel"
>
  <view class="dlg">
    <view class="dlg__member" wx:if="{{target}}">
      <view class="dlg__avatar">{{target.avatarText}}</view>
      <view class="dlg__info">
        <view class="dlg__name">{{target.name}}</view>
        <view class="dlg__meta">{{target.company}} · 票号 {{target.ticketTail}}</view>
      </view>
    </view>

    <view class="dlg__label">
      <text>补签原因</text>
      <text class="dlg__required">必选</text>
    </view>
    <t-radio-group value="{{reason}}" borderless bind:change="onReasonChange">
      <t-radio
        wx:for="{{reasons}}"
        wx:key="key"
        value="{{item.key}}"
        label="{{item.label}}"
        class="dlg__radio"
      />
    </t-radio-group>

    <view wx:if="{{reason === 'other'}}" class="dlg__field">
      <view class="dlg__label">
        <text>补签说明</text>
        <text class="dlg__required">必填</text>
      </view>
      <t-textarea
        value="{{note}}"
        placeholder="请说明无法扫码签到的原因，例如：闸机临时断电"
        maxlength="100"
        indicator
        autosize="{{ { minHeight: 72 } }}"
        bind:change="onNoteInput"
      />
    </view>

    <view wx:if="{{reason === 'other' && !note}}" class="dlg__hint">
      选择「其他」时需填写说明后才能确认补签
    </view>

    <view wx:if="{{localError || errorText}}" class="dlg__error">
      <t-icon name="error-circle" size="28rpx" color="#d54941" />
      <text>{{localError || errorText}}</text>
    </view>

    <view class="dlg__tip">补签后该会员状态立即变为「已签到」，请先核对本人票号。</view>
  </view>
</t-dialog>
