.dlg {
  padding: 4rpx 0 8rpx;
  font-size: 26rpx;
  color: rgba(0, 0, 0, 0.9);
}

.dlg__member {
  display: flex;
  align-items: center;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  background: #f5f7fa;
}

.dlg__avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: #e3f0ff;
  color: #0052d9;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.dlg__info {
  margin-left: 16rpx;
  min-width: 0;
}

.dlg__name {
  font-size: 30rpx;
  font-weight: 600;
}

.dlg__meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(0, 0, 0, 0.5);
}

.dlg__label {
  display: flex;
  align-items: center;
  margin: 28rpx 0 8rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: rgba(0, 0, 0, 0.9);
}

.dlg__required {
  margin-left: 10rpx;
  padding: 0 8rpx;
  height: 28rpx;
  line-height: 28rpx;
  border-radius: 4rpx;
  background: #fff1e9;
  color: #e37318;
  font-size: 18rpx;
  font-weight: 400;
}

.dlg__radio {
  display: block;
}

.dlg__field {
  margin-top: 8rpx;
}

.dlg__hint {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #e37318;
}

.dlg__error {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 10rpx;
  background: #fff1e9;
  color: #d54941;
  font-size: 24rpx;
  line-height: 32rpx;
}

.dlg__error text {
  margin-left: 8rpx;
}

.dlg__tip {
  margin-top: 20rpx;
  font-size: 22rpx;
  line-height: 34rpx;
  color: rgba(0, 0, 0, 0.4);
}
